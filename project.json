{
  "name" : "jam4j",
  "version" : "1.0.3-SNAPSHOT",
  "dependencies" : {
    "info.picocli:picocli" : "4.7.6",
    "com.fasterxml.jackson.core:jackson-databind" : "2.17.1",
    "org.apache.maven.resolver:maven-resolver-api" : "1.9.20",
